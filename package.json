{
  "name": "video-shell",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "studio": "remotion studio src/remotion/Root.tsx",
    "render:sample": "tsx scripts/render-sample.ts",
    "preflight:render": "tsx scripts/preflight-render.ts",
    "render:lesson": "tsx scripts/render-lesson.ts",
    "render:smoke": "tsx scripts/render-smoke.ts",
    "render:still": "tsx scripts/render-still.ts",
    "render:clip": "tsx scripts/render-clip.ts",
    "list:lessons": "tsx scripts/list-lessons.ts",
    "create:lesson": "tsx scripts/create-lesson.ts",
    "validate:all": "tsx scripts/validate-all.ts",
    "preflight:all": "tsx scripts/preflight-all.ts",
    "render:all": "tsx scripts/render-all.ts",
    "render:failed": "tsx scripts/render-failed.ts",
    "batch:list": "npm run list:lessons",
    "batch:create": "npm run create:lesson",
    "batch:validate": "npm run validate:all",
    "batch:preflight": "npm run preflight:all",
    "batch:render": "npm run render:all",
    "batch:render:failed": "npm run render:failed",
    "test": "npm run validate:lessons && npm run test:hud && npm run test:hud:sample && npm run test:preflight",
    "test:hud": "tsx scripts/test-hud-state.ts",
    "test:hud:sample": "tsx scripts/test-hud-state.ts -- --lesson lesson-01.sample --times 0,30,92,146,176,240,288,300,432,450,485,500",
    "test:preflight": "tsx scripts/test-preflight-render.ts",
    "validate:lessons": "tsx scripts/validate-lessons.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.477",
    "@remotion/cli": "4.0.477",
    "@remotion/media-parser": "4.0.477",
    "@remotion/media-utils": "4.0.477",
    "@remotion/renderer": "4.0.477",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.477",
    "tsx": "^4.20.0",
    "vite": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.61.0",
    "typescript": "^5.8.0"
  }
}
